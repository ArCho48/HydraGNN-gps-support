{
  "Verbosity": {
    "level": 2
  },
  "NeuralNetwork": {
    "Architecture": {
      "global_attn_engine": "GPS",
      "global_attn_type": "multihead",
      "mpnn_type": "EGNN",
      "edge_features": ["bond_length"],
      "max_neighbours": 50,
      "num_gaussians": 50,
      "num_filters": 50,
      "envelope_exponent": 5,
      "int_emb_size": 64,
      "basis_emb_size": 8,
      "out_emb_size": 128,
      "num_after_skip": 2,
      "num_before_skip": 1,
      "num_radial": 6,
      "num_spherical": 7,
      "radius": 5.0,
      "hidden_dim": 200,
      "edge_embed_dim": 0,
      "num_conv_layers": 6,
      "use_encodings": false,
      "num_laplacian_eigs": 3,
      "output_heads": {
        "graph": {
          "num_sharedlayers": 2,
          "dim_sharedlayers": 200,
          "num_headlayers": 2,
          "dim_headlayers": [
            1000,
            1000
          ]
        },
        "node": {
          "num_headlayers": 2,
          "dim_headlayers": [1000,1000],
          "type": "mlp"
        }
      },
      "task_weights": [
        1, 1, 1, 1, 1
      ]
    },
    "Variables_of_interest": {
      "input_node_features": [0, 1, 2, 3],
      "output_index": [
        0, 1, 2, 3, 4
      ],
      "type": ["graph"],
      "graph_feature_dims": [1],
      "output_names": ["HLGAP"],
      "node_feature_dims": [1, 3, 3, 1, 1, 1],
      "denormalize_output": false
    },
    "Training": {
      "Checkpoint" : true,
      "loss_function_type": "mae",
      "num_epoch": 20,
      "batch_size": 8,
      "continue": 0,
      "EarlyStopping": true,
      "Optimizer": {
        "type": "AdamW",
        "learning_rate": 0.001
      }
    }
  }
}
